# Files that exist only on the server - never overwrite from CI. .env and
# Headscale's data are the server's own; the rest is generated there by
# `meshploy domain apply` from the base domains it serves.
.env
caddy/Caddyfile
caddy/conf.d/
coredns/Corefile
coredns/zones/
headscale/config/config.yaml
headscale/data/
