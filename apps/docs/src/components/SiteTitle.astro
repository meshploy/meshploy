---
import logo from '../assets/logo.svg';
---

<div class="docs-brand">
  <a class="site-title sl-flex" href="https://meshploy.com/">
    <img src={logo.src} width="29" height="29" alt="" />
    <span>meshploy</span>
  </a>
  <span class="docs-brand-divider" aria-hidden="true">/</span>
  <a class="docs-brand-label" href="/">Docs</a>
</div>

<style>
  .site-title { align-items: center; text-decoration: none; white-space: nowrap; }
  .docs-brand { display: flex; align-items: center; gap: 0.65rem; white-space: nowrap; }
  .docs-brand-divider { color: var(--sl-color-gray-4); font-weight: 400; }
  .docs-brand-label { color: var(--sl-color-text-accent); font-size: 0.85rem; font-weight: 500; text-decoration: none; }
  .docs-brand-label:hover { color: var(--sl-color-white); }
</style>
