#!/usr/bin/env bash
# Meshploy build script — runs inside the K8s builder Job container.
# Environment variables are injected by the K8s Job spec:
#   GIT_URL        https clone URL, without credentials
#   GIT_REPO       the repository as stored (owner/repo, a GitLab path, or a
#                  URL): for log lines, and the clone source when an API from
#                  before GIT_URL sends only this
#   GIT_BRANCH     branch to build
#   GIT_USER       user presented with GIT_TOKEN (x-access-token, oauth2)
#   GIT_TOKEN      access token; empty for a public repository
#   GIT_COMMIT     optional: build this commit of the branch rather than its
#                  newest - what a stack's last sync read
#   SOURCE_URL     instead of the GIT_* ones: an uploaded folder, a tar.gz
#                  blob in the registry, fetched with the registry's password
#   SOURCE_DIGEST  sha256:<hex> the fetched archive must match
#   SOURCE_NAME    the folder's name, for log lines
#   BUILDER        railpack | dockerfile
#   INSTALL_COMMAND, BUILD_COMMAND   optional: replace Railpack's own
#   IMAGE_DEST     registry/image:tag to push to
#   REGISTRY_HOST  registry hostname (for buildah login)
#   REGISTRY_USER  registry username
#   REGISTRY_PASS  registry password

set -euo pipefail

log() { echo -e "\033[1;34m[meshploy-build]\033[0m $*"; }
die() { echo -e "\033[1;31m[meshploy-build] ERROR:\033[0m $*" >&2; exit 1; }

if [[ -z "${SOURCE_URL:-}" ]]; then
    [[ -z "${GIT_URL:-}" && -z "${GIT_REPO:-}" ]] && die "GIT_URL is not set"
    [[ -z "${GIT_BRANCH:-}"  ]] && die "GIT_BRANCH is not set"
else
    [[ -z "${SOURCE_DIGEST:-}" ]] && die "SOURCE_DIGEST is not set"
fi
[[ -z "${IMAGE_DEST:-}"  ]] && die "IMAGE_DEST is not set"
[[ -z "${REGISTRY_HOST:-}" ]] && die "REGISTRY_HOST is not set"

BUILDER="${BUILDER:-railpack}"
# Nixpacks was retired for Railpack, its successor, which reads the same
# projects. An API from before then still sends it for a service saved with it.
[[ "${BUILDER}" == "nixpacks" ]] && BUILDER=railpack
# Overridable so the clone can be exercised outside a build pod.
WORKDIR="${MESHPLOY_BUILD_WORKDIR:-/tmp/workspace}"

# ── Parse build-time env vars ─────────────────────────────────────────────────
# BUILD_ENV_VARS is a newline-separated list of KEY=VALUE pairs.
# Build arrays of flags for each builder from the non-empty, non-comment lines.
RAILPACK_ENV_FLAGS=()
RAILPACK_SECRET_FLAGS=()
DOCKERFILE_BUILD_ARG_FLAGS=()

if [[ -n "${BUILD_ENV_VARS:-}" ]]; then
    while IFS= read -r line; do
        # Skip blank lines and comments
        [[ -z "$line" || "$line" == \#* ]] && continue
        key="${line%%=*}"
        value="${line#*=}"
        # Strip one layer of surrounding single or double quotes from the value.
        # Users often write KEY="value with spaces" — the quotes are shell syntax
        # and should not be part of the actual value passed to the build tool.
        if [[ ${#value} -ge 2 ]]; then
            first="${value:0:1}" last="${value: -1}"
            if [[ "$first" == '"' && "$last" == '"' ]] || \
               [[ "$first" == "'" && "$last" == "'" ]]; then
                value="${value:1:${#value}-2}"
            fi
        fi
        RAILPACK_ENV_FLAGS+=(--env "${key}=${value}")
        DOCKERFILE_BUILD_ARG_FLAGS+=(--build-arg "${key}=${value}")
        # Railpack embeds build env vars as BuildKit secrets in the plan.
        # Export + --secret makes them available to buildctl.
        export "${key}=${value}"
        RAILPACK_SECRET_FLAGS+=(--secret "id=${key},env=${key}")
    done <<< "${BUILD_ENV_VARS}"
fi

# ── Install and build commands ────────────────────────────────────────────────
# Set in the console to replace what the builder works out for itself; empty
# leaves it to the builder. Railpack takes the build command as a flag and the
# install command as its RAILPACK_INSTALL_CMD variable. A Dockerfile build ignores both: its steps are in the Dockerfile.
RAILPACK_CMD_FLAGS=()
if [[ -n "${INSTALL_COMMAND:-}" ]]; then
    RAILPACK_CMD_FLAGS+=(--env "RAILPACK_INSTALL_CMD=${INSTALL_COMMAND}")
fi
if [[ -n "${BUILD_COMMAND:-}" ]]; then
    RAILPACK_CMD_FLAGS+=(--build-cmd "${BUILD_COMMAND}")
fi

# ── Uploaded folder ───────────────────────────────────────────────────────────
# A folder uploaded instead of a repository: fetched from the registry by its
# digest, checked against it, and unpacked where a clone would be. The API
# refused an archive with a path or a link leading out of the folder; it is
# refused again here, before anything is written.
fetch_upload() {
    local archive=/tmp/source.tar.gz auth=()
    [[ -n "${REGISTRY_USER:-}" ]] && auth=(--user "${REGISTRY_USER}:${REGISTRY_PASS:-}")
    log "Fetching the uploaded folder ${SOURCE_NAME:-}…"
    curl -fsSL "${auth[@]+"${auth[@]}"}" -o "${archive}" "${SOURCE_URL}" \
        || die "Could not fetch the uploaded folder from the registry: upload it again"
    echo "${SOURCE_DIGEST#sha256:}  ${archive}" | sha256sum -c - >/dev/null 2>&1 \
        || die "The uploaded folder does not match its digest ${SOURCE_DIGEST}"
    if tar -tzf "${archive}" | grep -qE '(^/|(^|/)\.\.(/|$))'; then
        die "The uploaded folder has a path leading out of it"
    fi
    if tar -tvzf "${archive}" | grep -E '^l' | grep -qE ' -> (/|(.*/)?\.\.(/|$))'; then
        die "The uploaded folder has a link leading out of it"
    fi
    mkdir -p "${WORKDIR}"
    tar -xzf "${archive}" -C "${WORKDIR}" --no-same-owner
    rm -f "${archive}"
    cd "${WORKDIR}"
    log "Unpacked $(find . -type f | wc -l) files"
    # Read back by the API like a clone's: the digest stands in for the hash.
    local hex="${SOURCE_DIGEST#sha256:}"
    log "Commit: ${hex:0:12} Uploaded from ${SOURCE_NAME:-a folder}"
}

if [[ -n "${SOURCE_URL:-}" ]]; then
    fetch_upload
else
    # ── Clone ─────────────────────────────────────────────────────────────────────
    # An API from before GIT_URL existed sends only GIT_REPO, which it always meant
    # as owner/repo on github.com.
    if [[ -z "${GIT_URL:-}" ]]; then
        case "${GIT_REPO}" in
            http://*|https://*) GIT_URL="${GIT_REPO}" ;;
            *)                  GIT_URL="https://github.com/${GIT_REPO}.git" ;;
        esac
    fi

    # The token goes to git as a header on this one command, through git's
    # environment config. It is never written into the URL: git records the remote
    # URL in .git/config, and a build that copies its context would carry the token
    # into the image.
    if [[ -n "${GIT_TOKEN:-}" ]]; then
        export GIT_CONFIG_COUNT=1 GIT_CONFIG_KEY_0=http.extraHeader
        GIT_CONFIG_VALUE_0="Authorization: Basic $(printf '%s:%s' "${GIT_USER:-x-access-token}" "${GIT_TOKEN}" | base64 -w0)"
        export GIT_CONFIG_VALUE_0
    fi

    if [[ -n "${GIT_COMMIT:-}" ]]; then
        # The commit a stack's last sync read, so an apply builds what that
        # sync saw and not whatever the branch has now. Asked for by hash
        # first, as GitHub, GitLab and Gitea allow; a server that refuses
        # gets the branch's recent history, which holds any commit a recent
        # sync read.
        log "Cloning ${GIT_REPO:-${GIT_URL}}@${GIT_BRANCH} at ${GIT_COMMIT:0:12}…"
        git init -q "${WORKDIR}"
        git -C "${WORKDIR}" remote add origin "${GIT_URL}"
        if GIT_TERMINAL_PROMPT=0 git -C "${WORKDIR}" fetch -q --depth=1 origin "${GIT_COMMIT}" 2>/dev/null; then
            git -C "${WORKDIR}" checkout -q FETCH_HEAD
        elif GIT_TERMINAL_PROMPT=0 git -C "${WORKDIR}" fetch -q --depth=200 origin "${GIT_BRANCH}" \
            && git -C "${WORKDIR}" cat-file -e "${GIT_COMMIT}^{commit}" 2>/dev/null; then
            git -C "${WORKDIR}" checkout -q "${GIT_COMMIT}"
        else
            die "Commit ${GIT_COMMIT} is not on ${GIT_BRANCH} any more (force-pushed, or over 200 commits back): sync the stack to build what the branch has now"
        fi
    else
        log "Cloning ${GIT_REPO:-${GIT_URL}}@${GIT_BRANCH}…"
        GIT_TERMINAL_PROMPT=0 git clone --depth=1 --branch "${GIT_BRANCH}" "${GIT_URL}" "${WORKDIR}"
    fi
    # Nothing after the clone needs them, and the build tools inherit this
    # environment.
    unset GIT_CONFIG_COUNT GIT_CONFIG_KEY_0 GIT_CONFIG_VALUE_0 GIT_TOKEN
    cd "${WORKDIR}"
    log "Cloned successfully ($(git rev-parse --short HEAD))"
    # Read back by the API to record what was built: hash, then the subject line.
    log "Commit: $(git log -1 --format='%h %s')"
fi

# ── Subdirectory ──────────────────────────────────────────────────────────────
# ROOT_DIR is set when the service's build.context points to a subdirectory.
# The whole repo was cloned once; we just cd into the right subdir to build.
if [[ -n "${ROOT_DIR:-}" ]]; then
    [[ -d "${WORKDIR}/${ROOT_DIR}" ]] || die "ROOT_DIR '${ROOT_DIR}' not found in repo"
    log "Building from subdirectory: ${ROOT_DIR}"
    cd "${WORKDIR}/${ROOT_DIR}"
fi

# ── Stack ─────────────────────────────────────────────────────────────────────
# What the app is, read back by the API for the console's hints: its language,
# its framework and entry point, dependencies known to need a lot of memory,
# and a Dockerfile it already has. One "Stack:" line per fact. Only looks;
# never fails the build.
detect_stack() {
    local prune=(-name .git -o -name node_modules -o -name .venv -o -name venv -o -name __pycache__ -o -name dist -o -name build)
    local deps="" file var

    if [[ -f requirements.txt || -f pyproject.toml || -f Pipfile || -f setup.py ]]; then
        log "Stack: language python"
        deps=$(cat requirements*.txt pyproject.toml Pipfile setup.py 2>/dev/null | tr '[:upper:]_' '[:lower:]-' || true)
        # The ASGI or WSGI app object: "app = FastAPI(" in app/main.py is app.main:app.
        for fw in FastAPI Flask; do
            file=$(find . -maxdepth 4 \( "${prune[@]}" \) -prune -o -name '*.py' -print 2>/dev/null \
                | xargs -r grep -lE "^[A-Za-z_][A-Za-z0-9_]*[[:space:]]*(:[^=]*)?=[[:space:]]*${fw}\(" 2>/dev/null | head -1)
            [[ -z "$file" ]] && continue
            var=$(grep -m1 -oE "^[A-Za-z_][A-Za-z0-9_]*[[:space:]]*(:[^=]*)?=[[:space:]]*${fw}\(" "$file" | grep -oE '^[A-Za-z_][A-Za-z0-9_]*')
            file="${file#./}"; file="${file%.py}"
            log "Stack: entry $(tr '[:upper:]' '[:lower:]' <<<"$fw") ${file//\//.}:${var}"
            break
        done
        if [[ -z "$file" && -f manage.py ]]; then
            file=$(find . -maxdepth 3 \( "${prune[@]}" \) -prune -o -name wsgi.py -print 2>/dev/null | head -1)
            if [[ -n "$file" ]]; then
                file="${file#./}"; file="${file%.py}"
                log "Stack: entry django ${file//\//.}"
            fi
        fi
    fi
    if [[ -f package.json ]]; then
        log "Stack: language node"
        deps+=$'\n'$(cat package.json 2>/dev/null || true)
        if ! grep -qE '"start"[[:space:]]*:' package.json; then
            for file in server.js index.js main.js app.js dist/index.js dist/main.js; do
                [[ -f "$file" ]] && { log "Stack: entry node ${file}"; break; }
            done
        fi
    fi
    [[ -f go.mod ]] && log "Stack: language go"
    [[ -f Gemfile ]] && log "Stack: language ruby"
    [[ -f composer.json ]] && log "Stack: language php"
    [[ -f Cargo.toml ]] && log "Stack: language rust"

    # Kept in step with the API's table of what each one needs.
    local heavy
    heavy=$(grep -oE '(^|[^a-z0-9-])(torch|tensorflow|jax|transformers|sentence-transformers|spacy|easyocr|paddleocr|onnxruntime|llama-cpp-python|vllm|puppeteer|playwright)([^a-z0-9-]|$)' <<<"$deps" 2>/dev/null \
        | grep -oE '[a-z0-9-]+' | sort -u | tr '\n' ' ' || true)
    [[ -n "${heavy// /}" ]] && log "Stack: heavy ${heavy% }"

    local df="${DOCKERFILE_PATH:-Dockerfile}"
    if [[ -f "$df" ]]; then
        if grep -qiE '^[[:space:]]*(CMD|ENTRYPOINT)[[:space:]]' "$df"; then
            log "Stack: dockerfile ${df} cmd"
        else
            log "Stack: dockerfile ${df}"
        fi
        local expose
        expose=$(grep -m1 -iE '^[[:space:]]*EXPOSE[[:space:]]+[0-9]+' "$df" | grep -oE '[0-9]+' | head -1 || true)
        [[ -n "$expose" ]] && log "Stack: expose ${expose}"
    fi
    return 0
}
detect_stack || true

# ── Mark registry as insecure if it is HTTP ──────────────────────────────────
# buildah defaults to HTTPS. Internal mesh registries (e.g. 100.64.x.x:5000)
# are plain HTTP — add them to registries.conf so buildah doesn't upgrade to TLS.
# This covers both `buildah push` and `buildah build --cache-from`.
mkdir -p "${HOME}/.config/containers"
# This file is read instead of the system's, so it says what the system's
# does too: a short name (FROM golang:1.24-alpine) means Docker Hub, as Docker
# reads it. Top-level keys go before any [[registry]] table.
if ! grep -q '^unqualified-search-registries' "${HOME}/.config/containers/registries.conf" 2>/dev/null; then
    printf 'unqualified-search-registries = ["docker.io"]\nshort-name-mode = "permissive"\n' \
        | cat - "${HOME}/.config/containers/registries.conf" 2>/dev/null > /tmp/registries.conf || true
    mv /tmp/registries.conf "${HOME}/.config/containers/registries.conf"
fi
cat >> "${HOME}/.config/containers/registries.conf" <<EOF

[[registry]]
location = "${REGISTRY_HOST}"
insecure = true
EOF

# ── Registry login ────────────────────────────────────────────────────────────
if [[ -n "${REGISTRY_USER:-}" && -n "${REGISTRY_PASS:-}" ]]; then
    log "Logging in to ${REGISTRY_HOST}…"
    echo "${REGISTRY_PASS}" | buildah login \
        --username "${REGISTRY_USER}" \
        --password-stdin \
        "${REGISTRY_HOST}"
    # Mirror credentials for BuildKit (used by railpack).
    # BuildKit reads ~/.docker/config.json, not buildah's auth.json.
    mkdir -p "${HOME}/.docker"
    echo "${REGISTRY_PASS}" | docker login \
        --username "${REGISTRY_USER}" \
        --password-stdin \
        "${REGISTRY_HOST}" 2>/dev/null || \
    printf '{"auths":{"%s":{"auth":"%s"}}}' \
        "${REGISTRY_HOST}" \
        "$(printf '%s:%s' "${REGISTRY_USER}" "${REGISTRY_PASS}" | base64 -w0)" \
        > "${HOME}/.docker/config.json"
fi

# ── Build ─────────────────────────────────────────────────────────────────────
# Strip tag to get the bare repo ref for --cache-from.
# Guard: if IMAGE_DEST has no tag (e.g. a registry with a port like
# host:5000/app) the naive %:* pattern would eat the port instead of the tag.
# Only strip when the final path component (after the last /) contains a colon.
_IMAGE_FINAL="${IMAGE_DEST##*/}"
if [[ "${_IMAGE_FINAL}" == *:* ]]; then
    CACHE_FROM_REPO="${IMAGE_DEST%:*}"
else
    CACHE_FROM_REPO="${IMAGE_DEST}"
fi
unset _IMAGE_FINAL

case "${BUILDER}" in
  railpack)
    log "Building with Railpack → ${IMAGE_DEST}"
    # Railpack requires a BuildKit daemon. Start rootless buildkitd, wait for
    # the socket, then run railpack. --oci-worker-no-process-sandbox is required
    # in containers where full kernel namespace sandboxing is unavailable.
    BUILDKIT_SOCK="/tmp/buildkitd.sock"

    # Tell buildkitd the internal registry is plain HTTP (not HTTPS).
    mkdir -p /tmp/buildkit-config
    cat > /tmp/buildkit-config/buildkitd.toml <<EOF
[registry."${REGISTRY_HOST}"]
  http = true
  insecure = true
EOF

    # auto is overlayfs wherever the cache volume supports it, native
    # elsewhere. native stores every step as a full copy of the filesystem,
    # about a gigabyte for a Node build: slow to write, and enough to push the
    # cache over its limit so each build's trim deletes the steps the next one
    # needs.
    # Every build in a project shares one cache, and one BuildKit may use it
    # at a time: a second daemon on the same root cannot start. So a build
    # waits for the others in its project, and after BUILDKIT_LOCK_WAIT seconds
    # builds without the cache rather than wait longer.
    BUILDKIT_ROOT=/tmp/buildkit-root
    exec 9>"${BUILDKIT_ROOT}/.build.lock"
    waited=0
    until flock -n 9; do
        if (( waited == 0 )); then log "Waiting for another build in this project to finish with the build cache…"; fi
        if (( waited >= ${BUILDKIT_LOCK_WAIT:-1200} )); then
            log "Still busy after $(( waited / 60 )) minutes: building without the cache."
            BUILDKIT_ROOT="$(mktemp -d /tmp/buildkit-private.XXXXXX)"
            break
        fi
        sleep 5
        waited=$(( waited + 5 ))
    done

    start_buildkitd() {
        rm -f "${BUILDKIT_SOCK}"
        > /tmp/buildkitd.log          # reset log so readiness grep is unambiguous
        buildkitd \
            --addr "unix://${BUILDKIT_SOCK}" \
            --root "${BUILDKIT_ROOT}" \
            --oci-worker-snapshotter=auto \
            --config /tmp/buildkit-config/buildkitd.toml \
            2>/tmp/buildkitd.log &
        BUILDKITD_PID=$!
    }

    # Returns 0 when buildkitd prints "running server" (gRPC listener active).
    # buildkitd emits this line only after workers are initialised, so it is a
    # reliable readiness signal — unlike polling via buildctl which returns fast
    # gRPC errors while the daemon is still starting up.
    wait_buildkitd_ready() {
        local secs="${1:-30}"
        for i in $(seq 1 "${secs}"); do
            grep -q "running server" /tmp/buildkitd.log 2>/dev/null && return 0
            sleep 1
        done
        return 1
    }

    export BUILDKIT_HOST="unix://${BUILDKIT_SOCK}"

    log "Starting buildkitd…"
    start_buildkitd

    log "Checking buildkitd responsiveness…"
    if ! wait_buildkitd_ready 20; then
        log "buildkitd unresponsive — clearing stale PVC state and restarting…"
        kill "${BUILDKITD_PID}" 2>/dev/null || true
        sleep 2
        # Safe only because this build holds the cache's lock, so no other
        # daemon is using it. The root is a PVC subpath mount, which cannot
        # itself be deleted ("Resource busy"): delete only its contents,
        # keeping the lock file this build holds.
        find "${BUILDKIT_ROOT}" -mindepth 1 ! -name .build.lock -delete 2>/dev/null || true
        start_buildkitd
        wait_buildkitd_ready 30 \
            || { cat /tmp/buildkitd.log; die "buildkitd failed to start after state reset"; }
    fi

    # A cache kept by the native snapshotter is never read once overlayfs is
    # in use, and holds gigabytes.
    if [[ -d "${BUILDKIT_ROOT}/runc-overlayfs" && -d "${BUILDKIT_ROOT}/runc-native" ]]; then
        log "Removing the build cache kept in the old format…"
        rm -rf "${BUILDKIT_ROOT}/runc-native"
    fi

    # Generate the railpack build plan, then drive BuildKit directly via buildctl.
    # Using type=image,push=true bypasses the railpack CLI's docker-tar-to-stdout
    # output entirely — no stdout capture, no tar boundary scan, no separate push.
    # The plan and the context are the folder being built: the ROOT_DIR
    # subdirectory when there is one. The context was the repository's root,
    # which the plan made in the subdirectory does not describe ("/package.json":
    # not found).
    BUILD_DIR="${PWD}"
    log "Preparing railpack build plan…"
    railpack prepare . \
        --plan-out "${BUILD_DIR}/railpack-plan.json" \
        "${RAILPACK_ENV_FLAGS[@]+"${RAILPACK_ENV_FLAGS[@]}"}" \
        "${RAILPACK_CMD_FLAGS[@]+"${RAILPACK_CMD_FLAGS[@]}"}"

    log "Building and pushing via BuildKit frontend → ${IMAGE_DEST}"
    buildctl build \
        --frontend=gateway.v0 \
        --opt source=ghcr.io/railwayapp/railpack-frontend \
        --local context="${BUILD_DIR}" \
        --local dockerfile="${BUILD_DIR}" \
        --output "type=image,name=${IMAGE_DEST},push=true,registry.insecure=true" \
        --progress plain \
        "${RAILPACK_SECRET_FLAGS[@]+"${RAILPACK_SECRET_FLAGS[@]}"}"

    # Keep the cache under the project's limit: BuildKit drops the least
    # recently used layers first, so what the next build needs is what stays.
    if [[ "${CACHE_LIMIT_MB:-0}" -gt 0 ]]; then
        log "Trimming the build cache to ${CACHE_LIMIT_MB} MB…"
        buildctl prune --keep-storage "${CACHE_LIMIT_MB}" >/dev/null \
            || log "Could not trim the build cache; the build itself succeeded."
    fi

    kill "${BUILDKITD_PID}" 2>/dev/null || true
    ;;

  dockerfile)
    log "Building with Dockerfile → ${IMAGE_DEST}"
    # As the image sets it, for a builder image from before it did.
    export BUILDAH_ISOLATION="${BUILDAH_ISOLATION:-chroot}"
    DOCKERFILE="${DOCKERFILE_PATH:-Dockerfile}"
    [[ -f "${DOCKERFILE}" ]] || die "Dockerfile not found at ${DOCKERFILE}"
    # --layers enables intermediate layer caching in the PVC-backed OCI storage.
    # --cache-from uses the last successfully pushed image as the cache source,
    # so stale intermediate layers from failed builds are never reused.
    buildah build \
        --layers \
        --cache-from "${CACHE_FROM_REPO}" \
        --file "${DOCKERFILE}" \
        --tag "${IMAGE_DEST}" \
        "${DOCKERFILE_BUILD_ARG_FLAGS[@]+"${DOCKERFILE_BUILD_ARG_FLAGS[@]}"}" \
        .
    ;;

  *)
    die "Unknown builder: ${BUILDER}. Valid values: railpack, dockerfile"
    ;;
esac

# ── Push ──────────────────────────────────────────────────────────────────────
# dockerfile: image is in buildah's local store after `buildah build`.
# railpack: already pushed to the registry by buildctl above — nothing to do.
# buildah uses registries.conf (written above) to reach HTTP registries.
case "${BUILDER}" in
  dockerfile)
    log "Pushing ${IMAGE_DEST}…"
    buildah push "${IMAGE_DEST}" "docker://${IMAGE_DEST}"
    ;;
esac

# ── Cache limit (Buildah) ─────────────────────────────────────────────────────
# Buildah cannot trim its layer cache to a size, so over the limit it is
# emptied, and the next build starts cold. Never fails the build.
case "${BUILDER}" in
  dockerfile)
    if [[ "${CACHE_LIMIT_MB:-0}" -gt 0 ]]; then
        used_mb=$(du -sm /var/lib/containers/storage 2>/dev/null | cut -f1)
        if [[ "${used_mb:-0}" -gt "${CACHE_LIMIT_MB}" ]]; then
            log "Build cache is ${used_mb} MB, over the ${CACHE_LIMIT_MB} MB limit: emptying it."
            buildah rmi --all --force >/dev/null 2>&1 \
                || log "Could not empty the build cache; the build itself succeeded."
        fi
    fi
    ;;
esac

log "Build complete: ${IMAGE_DEST}"
