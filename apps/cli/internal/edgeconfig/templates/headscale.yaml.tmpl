# Headscale configuration for Meshploy - generated, do not edit.
#
# Rendered by `meshploy domain apply` from the edge snapshot at
# {{ .SnapshotPath }}.
# Edits here are lost the next time the set of base domains changes.

# Public URL Tailscale/Headscale clients connect to — must be HTTPS on 443.
# On the primary domain. A worker that joined through an earlier primary's name
# keeps working: that name keeps being served until its domain is removed.
server_url: https://headscale.{{ .Primary.BaseDomain }}

# Headscale listens on this address inside the container.
# Caddy proxies headscale.<domain>:443 → localhost:8085 → container:8080
listen_addr: 0.0.0.0:8080
metrics_listen_addr: 127.0.0.1:9090

# Key files — auto-generated on first start
private_key_path: /var/lib/headscale/private.key
noise:
  private_key_path: /var/lib/headscale/noise_private.key

# IP address ranges assigned to mesh nodes
prefixes:
  v4: 100.64.0.0/10
  v6: fd7a:115c:a1e0::/48
  allocation: sequential

# TLS handled by Caddy — leave empty
tls_cert_path: ""
tls_key_path: ""

# DERP relay — use Tailscale's public servers
derp:
  server:
    enabled: false
    region_id: 999
    region_code: "headscale"
    region_name: "Headscale Embedded DERP"
    stun_listen_addr: "0.0.0.0:3478"
  urls:
    - https://controlplane.tailscale.com/derpmap/default
  auto_update_enabled: true
  update_frequency: 24h

# Database — SQLite, stored in the mounted data volume
database:
  type: sqlite
  sqlite:
    path: /var/lib/headscale/db.sqlite

# DNS — mesh nodes use CoreDNS at the gateway's WireGuard IP
dns:
  magic_dns: true
  # Pinned to the install's domain: following the primary would rename every
  # node in the mesh.
  base_domain: {{ .MeshDomain }}
  nameservers:
    global:
      - 1.1.1.1
      - 1.0.0.1
    # Every base domain's internal zone, not only the primary's. CoreDNS serves
    # each one on the mesh address, but a node asks it only for the zones
    # listed here - so an internal route on any other domain would otherwise
    # never resolve.
    split:
{{- range .Domains }}
      "{{ .InternalSubdomain }}.{{ .BaseDomain }}":
        - {{ $.MeshIP }}
{{- end }}
  search_domains:
    - {{ .Primary.InternalSubdomain }}.{{ .Primary.BaseDomain }}

log:
  format: text
  level: info

ephemeral_node_inactivity_timeout: 30m
